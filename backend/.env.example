# Copy to .env and edit.
APP_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
ADMIN_EMAIL=admin@vortex.local
ADMIN_PASSWORD=change-me-before-deploy
# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql://vortex:vortex@localhost:5432/vortex
DATABASE_URL=sqlite:///vortex.db
CORS_ORIGINS=http://localhost:5173
MEDIA_URL_TTL_SECONDS=14400

# Optional email verification and password recovery (SMTP, TLS on port 587 or SSL on 465)
REQUIRE_EMAIL_VERIFICATION=false
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional media storage providers
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_URL=
SUPABASE_BUCKET=vortex-media

# Optional metadata import, local-library scanning, and thumbnail generation
TMDB_API_KEY=
# Separate configured roots with semicolons on Windows (or colons on Linux/macOS).
MEDIA_SCAN_ROOTS=
FFMPEG_BIN=ffmpeg
